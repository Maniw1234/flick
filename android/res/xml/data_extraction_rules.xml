<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Flick's leaves the phone in a backup or a move to a new phone: its settings hold the pairing keys and the
     phone's own id (two phones with one id would take each other's place on the PC). android:allowBackup="false" says
     so up to Android 11; from Android 12 a move to a new phone ignores it and follows these rules instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
